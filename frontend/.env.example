# Copiar a .env y completar. Nunca commitear .env (ver CLAUDE.md §11).

# Dirección del backend (DocApp Go (backend)/backend). En el celular con Expo Go va la IP de la
# computadora en la red, p. ej. http://192.168.0.10:3000 (localhost solo sirve en web).
EXPO_PUBLIC_API_URL=http://localhost:3000

# Clave de Google Maps (solo para la app compilada con react-native-maps; el mapa de hoy no la usa).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
